# --- Twilio (WhatsApp) ---
# Trovi SID e Auth Token nella Console Twilio: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Numero mittente WhatsApp.
# Per i test usa il numero della Sandbox Twilio: whatsapp:+14155238886
# In produzione: il tuo numero WhatsApp Business approvato.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- App ---
PORT=3000

# Percorso opzionale a una configurazione personalizzata
# FAMILY_CONFIG=/data/family.json

# Metti a 1 per NON inviare davvero i messaggi (utile per i test)
DRY_RUN=0

# Metti a 1 per disattivare lo scheduler automatico (es. se usi un cron esterno)
DISABLE_SCHEDULER=0
