# Cleanview API key (get a free key at https://cleanview.co)
# If not set, the tool falls back to scraping the public page.
CLEANVIEW_API_KEY=your_api_key_here

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# All five vars must be present to enable email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=you@gmail.com        # optional, defaults to SMTP_USER
EMAIL_TO=recipient@example.com

# ── Slack ─────────────────────────────────────────────────────────────────────
# Create an incoming webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
